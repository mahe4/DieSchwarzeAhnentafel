<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Eine einzelne ausführbare Datei mit eigener .NET-Laufzeit (keine Installation nötig).
       dotnet publish src/DSACharacterCreator.Desktop -p:PublishProfile=win-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- Die nativen SkiaSharp-/HarfBuzz-Pakete bringen .pdb-Dateien mit, die sonst neben der ausführbaren Datei landen. -->
  <Target Name="ExcludeNativePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
