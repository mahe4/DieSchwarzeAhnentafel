<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             xmlns:views="using:DSACharacterCreator.Views"
             x:Class="DSACharacterCreator.App"
             RequestedThemeVariant="Light">

    <!-- Stile: Light = Heldendokument (Standard), Dark = Nachtlager; Umschalten über AppTheme.Apply -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/ThemeResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- ViewModel → View ohne reflektionsbasierten ViewLocator (trimming-freundlich für Android). -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:LoadingViewModel">
            <views:LoadingView />
        </DataTemplate>
        <DataTemplate DataType="vm:CharacterListViewModel">
            <views:CharacterListView />
        </DataTemplate>
        <DataTemplate DataType="vm:EditorViewModel">
            <views:EditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:BasicsPageViewModel">
            <views:BasicsPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:PhaseViewModel">
            <views:PhaseView />
        </DataTemplate>
        <DataTemplate DataType="vm:TraitsPageViewModel">
            <views:TraitsPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:SpecialAbilitiesPageViewModel">
            <views:SpecialAbilitiesPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:AttributesPageViewModel">
            <views:AttributesPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:SkillsPageViewModel">
            <views:SkillsPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:CombatTechniquesPageViewModel">
            <views:CombatTechniquesPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:MagicPageViewModel">
            <views:MagicPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:EquipmentPageViewModel">
            <views:EquipmentPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:CharacterSheetPageViewModel">
            <views:CharacterSheetPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:SummaryViewModel">
            <views:SummaryView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#8B2E24" RegionColor="#F4EFE4" ErrorText="#A8281C"
                                       AltHigh="#FBF8F1" AltMediumHigh="#F4EFE4" AltMedium="#F4EFE4" AltLow="#F4EFE4"
                                       BaseHigh="#2A211A" BaseMediumHigh="#4A3F35" BaseMedium="#6B5E52"
                                       BaseMediumLow="#8C7F72" BaseLow="#D9CFBD"
                                       ChromeLow="#EFE4D3" ChromeMediumLow="#FBF8F1" ChromeMedium="#E4DBCB"
                                       ChromeHigh="#B9AC97" ChromeAltLow="#4A3F35"
                                       ListLow="#EFE4D3" ListMedium="#E4DBCB" />
                <ColorPaletteResources x:Key="Dark" Accent="#E3A44A" RegionColor="#121417" ErrorText="#F07A6A"
                                       AltHigh="#1B1E23" AltMediumHigh="#121417" AltMedium="#121417" AltLow="#121417"
                                       BaseHigh="#ECE9E4" BaseMediumHigh="#C9CDD3" BaseMedium="#A3A9B1"
                                       BaseMediumLow="#6E757F" BaseLow="#2E333B"
                                       ChromeLow="#1F232A" ChromeMediumLow="#1B1E23" ChromeMedium="#262A31"
                                       ChromeHigh="#3A404A" ChromeAltLow="#C9CDD3"
                                       ListLow="#262A31" ListMedium="#2E333B" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <!-- Schrift des gewählten Stils überall, auch in Aufklapplisten und Popups -->
        <Style Selector=":is(TextBlock)">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
        </Style>
        <Style Selector=":is(TemplatedControl)">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
        </Style>
        <Style Selector="Window, TopLevel">
            <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
        </Style>
        <StyleInclude Source="/Views/ValueRowStyles.axaml" />
        <StyleInclude Source="/Views/TraitRowStyles.axaml" />
        <!-- Hinzufügen-Knopf: Content ist die Bezeichnung; schmale Ansicht blendet sie aus (nur „＋“, EditorView). -->
        <Style Selector="Button.add">
            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="x:String">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="＋" />
                        <TextBlock Classes="buttonLabel" Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </Setter>
        </Style>
        <!-- Symbolknopf (44 × 44) mit Strichsymbol; Farbe folgt dem Stil, auf Akzentknöpfen die Akzent-Schriftfarbe -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon Path.buttonIcon">
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Button.accent.icon Path.buttonIcon">
            <Setter Property="Stroke" Value="{DynamicResource AccentButtonForeground}" />
            <Setter Property="StrokeThickness" Value="2.4" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.current">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock.overspent">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource HeadingAccent}" />
        </Style>
        <!-- „+“ der Werte-Zeilen: im Nachtlager gefüllt in Bernstein -->
        <Style Selector="Button.plus">
            <Setter Property="Background" Value="{DynamicResource StepPlusBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource StepPlusForeground}" />
        </Style>
        <Style Selector="Button.plus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StepPlusBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource StepPlusForeground}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
    </Application.Styles>
</Application>
