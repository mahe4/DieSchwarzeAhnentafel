<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             xmlns:views="using:DSACharacterCreator.Views"
             x:Class="DSACharacterCreator.App"
             RequestedThemeVariant="Default">

    <!-- ViewModel → View ohne reflektionsbasierten ViewLocator (trimming-freundlich für Android). -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:CharacterListViewModel">
            <views:CharacterListView />
        </DataTemplate>
        <DataTemplate DataType="vm:EditorViewModel">
            <views:EditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderPageViewModel">
            <views:PlaceholderPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:SummaryViewModel">
            <views:SummaryView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Application.Styles>
</Application>
