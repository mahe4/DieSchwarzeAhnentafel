<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             xmlns:views="using:DSACharacterCreator.Views"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="DSACharacterCreator.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!--
      Adaptives Layout über Container Queries:
        ≥ 1200 px  Navigation links · Inhalt · Übersicht rechts
        800–1199   Navigation links · Inhalt, Übersicht als kompakte Leiste oben
        < 800      Inhalt, kompakte Leiste oben, Navigation unten
    -->
    <Panel Container.Name="Shell" Container.Sizing="Width">
        <Panel.Styles>
            <!-- Standardwerte als Styles, nicht als lokale Werte: lokale Werte hätten Vorrang vor den Container Queries. -->
            <Style Selector="Border#NavHost">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="Width" Value="240" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
            </Style>
            <Style Selector="Border#CompactBar">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="ListBox#Nav TextBlock.short">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <ContainerQuery Name="Shell" Query="max-width:1199">
                <Style Selector="Border#SummaryHost">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="Border#CompactBar">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </ContainerQuery>
            <ContainerQuery Name="Shell" Query="max-width:799">
                <Style Selector="Border#NavHost">
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                </Style>
                <Style Selector="ListBox#Nav">
                    <Setter Property="ItemsPanel">
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </Setter>
                </Style>
                <Style Selector="ListBox#Nav ListBoxItem">
                    <Setter Property="Padding" Value="4,12" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="ListBox#Nav TextBlock.long">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="ListBox#Nav TextBlock.short">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </ContainerQuery>
        </Panel.Styles>

        <DockPanel>
            <Border x:Name="NavHost"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <ListBox x:Name="Nav"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SectionViewModel">
                            <Panel>
                                <TextBlock Classes="long" Text="{Binding Title}" />
                                <TextBlock Classes="short" Text="{Binding ShortTitle}"
                                           FontSize="12" HorizontalAlignment="Center" />
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="SummaryHost" DockPanel.Dock="Right" Width="300"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1,0,0,0">
                <views:SummaryView DataContext="{Binding Summary}" />
            </Border>

            <Border x:Name="CompactBar" DockPanel.Dock="Top" Padding="16,8"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Summary.ApText}" FontWeight="SemiBold" />
            </Border>

            <ContentControl Content="{Binding SelectedSection.Page}" />
        </DockPanel>
    </Panel>
</UserControl>
