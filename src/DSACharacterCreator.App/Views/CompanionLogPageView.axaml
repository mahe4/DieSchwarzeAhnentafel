<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.CompanionLogPageView"
             x:DataType="vm:CompanionLogPageViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Classes="h1" Text="Protokoll" />
            <TextBlock Classes="hint" Text="{Binding HeroAwardsText}" />

            <Border Classes="box">
                <StackPanel Spacing="6">
                    <TextBlock Classes="boxTitle" Text="Bonus-AP nach Meisterentscheid" />
                    <TextBlock Classes="hint" Text="Auch für die Startausbildung, wenn das Tier schon bei der Heldenerschaffung ausgebildet ist." />
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <TextBox x:Name="AwardAmount" Text="{Binding AwardAmount}" PlaceholderText="AP" Width="90" />
                        <TextBox Text="{Binding AwardNote}" PlaceholderText="Anlass (z. B. Startausbildung)" MinWidth="220" />
                        <Button x:Name="AwardButton" Content="Gutschreiben" Command="{Binding AwardCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Classes="hint" Text="Noch keine Einträge." IsVisible="{Binding IsEmpty}" />
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CompanionLogLineViewModel">
                        <Border Classes="traitRow">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DateText}" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ApText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Grid.Column="2" Content="✕" Classes="step" Command="{Binding DeleteCommand}"
                                        ToolTip.Tip="Eintrag löschen" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
