<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DSACharacterCreator.Views"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.CompanionValuesPageView"
             x:DataType="vm:CompanionValuesPageViewModel">
    <Panel views:WidthClasses.Rules="attributesWide:820..">
        <Panel.Styles>
            <Style Selector=".attributesWide ItemsControl#CompanionAttributeList">
                <Setter Property="ItemsPanel">
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" ColumnSpacing="24" />
                    </ItemsPanelTemplate>
                </Setter>
            </Style>
        </Panel.Styles>
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="8" MaxWidth="960" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="h1" Text="Eigenschaften" />
                    <TextBlock Grid.Column="1" Classes="pageAp" Text="{Binding PageApText}" ToolTip.Tip="In diesem Bereich ausgegebene AP des Tiers" />
                </Grid>
                <ItemsControl x:Name="CompanionAttributeList" ItemsSource="{Binding Attributes}" ItemTemplate="{StaticResource ValueRow}" />

                <TextBlock Classes="h2" Text="Lebens- und Astralenergie" Margin="0,16,0,0" />
                <ItemsControl ItemsSource="{Binding Energies}" ItemTemplate="{StaticResource ValueRow}" />

                <TextBlock Classes="h2" Text="Kampf" Margin="0,16,0,0" />
                <TextBlock Classes="hint" Text="{Binding CombatHint}" />
                <ItemsControl ItemsSource="{Binding Combat}" ItemTemplate="{StaticResource ValueRow}" />
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
