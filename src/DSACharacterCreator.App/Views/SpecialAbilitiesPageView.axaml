<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.SpecialAbilitiesPageView"
             x:DataType="vm:SpecialAbilitiesPageViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="8" MaxWidth="820" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="h1" Text="Sonderfertigkeiten" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TotalText}" Opacity="0.7" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="AddSpecialAbilityButton" Content="＋ Sonderfertigkeit"
                        Command="{Binding AddSpecialAbilityCommand}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding LanguageHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                       IsVisible="{Binding LanguageHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ItemsControl x:Name="SpecialAbilityList" ItemsSource="{Binding SpecialAbilities}" ItemTemplate="{StaticResource TraitRow}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
