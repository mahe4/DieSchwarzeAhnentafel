<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.SpecialAbilitiesPageView"
             x:DataType="vm:SpecialAbilitiesPageViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="8" MaxWidth="820" HorizontalAlignment="Stretch">
            <!-- Überschrift und AP wie auf allen Seiten; ＋ in der Zeile darunter neben dem Vorlagenhinweis -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="h1" Text="Sonderfertigkeiten" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="pageAp" Text="{Binding PageApText}" ToolTip.Tip="In diesem Bereich ausgegebene AP" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding LanguageHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"
                           IsVisible="{Binding LanguageHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Grid.Column="1" x:Name="AddSpecialAbilityButton" Classes="add" Content="Sonderfertigkeit" ToolTip.Tip="Sonderfertigkeit hinzufügen"
                        Command="{Binding AddSpecialAbilityCommand}" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl x:Name="SpecialAbilityList" ItemsSource="{Binding SpecialAbilities}" ItemTemplate="{StaticResource TraitRow}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
