<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DSACharacterCreator.Views"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.AttributesPageView"
             x:DataType="vm:AttributesPageViewModel">
    <!-- Breit: zweispaltig (820 px: Inhaltsbreite am Desktop zwischen Navigation und Übersicht). -->
    <Panel views:WidthClasses.Rules="attributesWide:820..">
        <Panel.Styles>
            <Style Selector=".attributesWide ItemsControl#AttributeList">
                <Setter Property="ItemsPanel">
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" ColumnSpacing="24" />
                    </ItemsPanelTemplate>
                </Setter>
            </Style>
        </Panel.Styles>
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="8" MaxWidth="960" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="h1" Text="Eigenschaften" />
                    <TextBlock Grid.Column="1" Classes="pageAp" Text="{Binding PageApText}" ToolTip.Tip="In diesem Bereich ausgegebene AP" />
                </Grid>
                <TextBlock Text="{Binding TotalText}" Opacity="0.7" Margin="0,-6,0,0" />
                <ItemsControl x:Name="AttributeList" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ValueRow}" />

                <StackPanel IsVisible="{Binding ShowEnergies}" Spacing="4" Margin="0,16,0,0">
                    <TextBlock Classes="h2" Text="Lebens-, Astral- und Karmaenergie" />
                    <TextBlock Text="Permanent verlorene AsP/KaP (z. B. durch die Bindung eines Traditionsartefakts) lassen sich für 2 AP je Punkt zurückkaufen. Zukauf nach der Erschaffung: Lebenspunkte bis KO, Astral- und Karmapunkte bis zur Leiteigenschaft – vorher alle verlorenen Punkte zurückkaufen."
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    <ItemsControl x:Name="EnergyList" ItemsSource="{Binding Energies}" ItemTemplate="{StaticResource ValueRow}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
