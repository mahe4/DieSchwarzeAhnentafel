<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.CombatTechniquesPageView"
             x:DataType="vm:CombatTechniquesPageViewModel">
    <!-- Virtualisiert: nur sichtbare Zeilen werden aufgebaut (schnelleres erstes Öffnen am Handy). -->
    <!-- Feste Breite (bis 960 px, linksbündig) statt Inhaltsbreite: Sonst ändert sich die Breite beim Scrollen mit den
         gerade aufgebauten Zeilen, und die −/+-Knöpfe springen (vor allem am Handy). -->
    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="960" />
        <ColumnDefinition Width="0" />
    </Grid.ColumnDefinitions>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="h1" Text="Kampftechniken" Margin="16,16,16,0" />
        <ListBox x:Name="CombatTechniqueList" ItemsSource="{Binding VisibleRows}" Background="Transparent" Margin="8,8,8,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CombatTechniqueRowViewModel">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ValueRow}" />
                        <TextBlock Text="{Binding CombatText}" FontSize="12" Margin="8,0,0,6" Opacity="0.85" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
    </Grid>
</UserControl>
