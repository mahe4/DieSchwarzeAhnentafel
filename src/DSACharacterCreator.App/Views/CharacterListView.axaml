<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             xmlns:views="using:DSACharacterCreator.Views"
             x:Class="DSACharacterCreator.Views.CharacterListView"
             x:DataType="vm:CharacterListViewModel">
    <Panel>
        <DockPanel MaxWidth="880" Margin="16">
            <!-- Kopf: Titel und Hauptaktionen; auf schmalen Bildschirmen bricht die Knopfzeile um. -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16" ItemSpacing="8" LineSpacing="8">
                <TextBlock Classes="h1" Text="Helden" VerticalAlignment="Center" Margin="0,0,24,0" />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <Button x:Name="NewButton" Classes="accent" Content="＋ Neuer Held" Command="{Binding NewCommand}" Padding="16,8" />
                    <Button Content="Importieren …" Command="{Binding ImportCommand}" Padding="12,8" />
                    <Button x:Name="SettingsButton" Content="Einstellungen …" Command="{Binding OpenSettingsCommand}"
                            Padding="12,8" ToolTip.Tip="Stil der Oberfläche, Standardquellen für neue Helden" />
                </WrapPanel>
            </WrapPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="4">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <SelectableTextBlock Text="{Binding StorageLocation, StringFormat='Speicherort: {0}'}"
                                     FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>

            <Panel>
                <TextBlock IsVisible="{Binding !HasCharacters}" Margin="0,48" Opacity="0.7"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Noch keine Helden vorhanden. Lege mit „Neuer Held“ deinen ersten an." />
                <ScrollViewer IsVisible="{Binding HasCharacters}">
                    <ItemsControl x:Name="CharacterList" ItemsSource="{Binding Characters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterCardViewModel">
                                <Border CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- Ganze Karte antippen öffnet den Helden. -->
                                        <Button Classes="card" Command="{Binding OpenCommand}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Background="Transparent" Padding="12">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Width="44" Height="44" CornerRadius="22"
                                                        Background="{DynamicResource SystemAccentColor}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="Bold"
                                                               Foreground="{DynamicResource OnAccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PhaseText}" Opacity="0.7" />
                                                    <TextBlock Text="{Binding ModifiedText}" FontSize="12" Opacity="0.6" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="⋮" FontSize="20" Width="48"
                                                VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                                HorizontalContentAlignment="Center" Background="Transparent"
                                                ToolTip.Tip="Weitere Aktionen">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Öffnen" Command="{Binding OpenCommand}" />
                                                    <MenuItem Header="Duplizieren" Command="{Binding DuplicateCommand}" />
                                                    <MenuItem Header="Exportieren …" Command="{Binding ExportCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="Löschen …" Command="{Binding DeleteCommand}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </DockPanel>

        <!-- Standardquellen für neue Helden -->
        <Border x:Name="SourcesOverlay" IsVisible="{Binding Sources, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#80000000">
            <Border MaxWidth="720" Margin="0,8" CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <views:SourcesView DataContext="{Binding Sources}" />
            </Border>
        </Border>

        <!-- Einstellungen: Stil und Standardquellen -->
        <Border x:Name="SettingsOverlay" IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#80000000">
            <Border MaxWidth="560" Margin="16" Padding="20" CornerRadius="{DynamicResource OverlayCornerRadius}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel Spacing="14" DataContext="{Binding Settings}" x:DataType="vm:AppSettingsViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h1" Text="Einstellungen" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="SettingsClose" Content="✕" Command="{Binding CloseCommand}"
                                ToolTip.Tip="Schließen" Width="44" Height="44" Padding="0" FontSize="18"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="h2" Text="Stil" />
                    <!-- Zwei Stilkarten mit Farbmuster; Anordnung bleibt in beiden gleich -->
                    <UniformGrid Columns="2" ColumnSpacing="10">
                        <RadioButton x:Name="ThemeHeldendokument" GroupName="Theme" IsChecked="{Binding IsHeldendokument}"
                                     HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <Border Height="40" CornerRadius="3" Background="#F4EFE4" BorderBrush="#B9AC97" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" Background="#2A211A" />
                                        <Border Width="18" Height="18" Background="#8B2E24" />
                                        <TextBlock Text="Aa" Foreground="#2A211A" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                   FontFamily="avares://DSACharacterCreator.App/Assets/Fonts#Spectral" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Heldendokument" FontWeight="SemiBold" />
                                <TextBlock Text="Hell, Papier und Ochsenblut" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeNachtlager" GroupName="Theme" IsChecked="{Binding IsNachtlager}"
                                     HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <Border Height="40" CornerRadius="10" Background="#121417">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#262A31" />
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#E3A44A" />
                                        <TextBlock Text="Aa" Foreground="#ECE9E4" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                   FontFamily="avares://DSACharacterCreator.App/Assets/Fonts#Barlow Semi Condensed" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Nachtlager" FontWeight="SemiBold" />
                                <TextBlock Text="Dunkel mit Bernstein, für wenig Licht" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <TextBlock Classes="h2" Text="Neue Helden" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Welche Publikationen bei neuen Helden aktiv sind." TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontSize="13" Opacity="0.8" />
                        <Button Grid.Column="1" x:Name="DefaultSourcesButton" Content="Standardquellen …"
                                Command="{Binding OpenSourcesCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Löschbestätigung als Overlay, funktioniert auf Desktop und Handy gleich. -->
        <Border x:Name="DeleteConfirmation" IsVisible="{Binding IsDeletePending}" Background="#80000000">
            <Border MaxWidth="420" Margin="16" Padding="20" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel Spacing="16">
                    <TextBlock Classes="h2" Text="Held löschen?" />
                    <TextBlock Text="{Binding PendingDeleteText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Abbrechen" Command="{Binding CancelDeleteCommand}" Padding="16,8" />
                        <Button x:Name="ConfirmDeleteButton" Content="Löschen" Command="{Binding ConfirmDeleteCommand}"
                                Padding="16,8" Classes="danger" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
