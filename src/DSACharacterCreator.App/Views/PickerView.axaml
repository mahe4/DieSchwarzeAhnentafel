<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.PickerView"
             x:DataType="vm:PickerViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="12,12,12,8">
            <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" x:Name="PickerAdded" Text="{Binding AddedText}" VerticalAlignment="Center" Opacity="0.7" />
            <Button Grid.Column="2" x:Name="PickerClose" Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Schließen"
                    Width="44" Height="44" Padding="0" FontSize="18"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>
        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8" Spacing="4">
            <TextBox x:Name="PickerSearch" Text="{Binding Search}" PlaceholderText="Suchen (Name oder Gruppe) …" />
            <TextBlock Text="{Binding CountText}" FontSize="12" Opacity="0.6" />
        </StackPanel>
        <!-- Virtualisiert: ListBox mit VirtualizingStackPanel erzeugt nur sichtbare Zeilen. -->
        <ListBox x:Name="PickerRows" ItemsSource="{Binding Rows}" Background="Transparent" Margin="8,0,8,8"
                 SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <!-- Auswahl/Hover der ListBox nicht hervorheben; die Zeilen sind Knöpfe. -->
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.DataTemplates>
                <DataTemplate DataType="vm:PickerHeaderViewModel">
                    <TextBlock Classes="h2" Text="{Binding Title}" Margin="4,12,0,4" />
                </DataTemplate>
                <DataTemplate DataType="vm:PickerItemViewModel">
                    <StackPanel>
                        <Button Command="{Binding PickCommand}" Classes.current="{Binding IsCurrent}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="Transparent" Padding="8,6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AddedText}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding AddedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                        </Button>
                        <!-- Sammelauswahl: Beschreibung und Hinzufügen, die Liste bleibt offen -->
                        <StackPanel IsVisible="{Binding IsExpanded}" Margin="8,0,8,10" Spacing="8">
                            <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap" Opacity="0.85" />
                            <Button Content="＋ Hinzufügen" Command="{Binding AddCommand}" Classes="accent" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.DataTemplates>
        </ListBox>
    </DockPanel>
</UserControl>
