<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.PickerView"
             x:DataType="vm:PickerViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,12,12,8">
            <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Schließen" Command="{Binding CloseCommand}" />
        </Grid>
        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8" Spacing="4">
            <TextBox x:Name="PickerSearch" Text="{Binding Search}" PlaceholderText="Suchen (Name oder Gruppe) …" />
            <TextBlock Text="{Binding CountText}" FontSize="12" Opacity="0.6" />
        </StackPanel>
        <ScrollViewer>
            <ItemsControl x:Name="PickerGroups" ItemsSource="{Binding Groups}" Margin="12,0,12,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PickerGroupViewModel">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Classes="h2" Text="{Binding Title}" Margin="4,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PickerItemViewModel">
                                        <Button Command="{Binding PickCommand}" Classes.current="{Binding IsCurrent}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Background="Transparent" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
