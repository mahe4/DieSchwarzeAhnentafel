<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.EquipmentPageView"
             x:DataType="vm:EquipmentPageViewModel">
    <UserControl.Styles>
        <Style Selector="Border.equipmentRow">
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
        <Style Selector="Border.summary">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
        <Style Selector="Button.remove">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.negative">
            <Setter Property="Foreground" Value="#C42B1C" />
        </Style>
        <Style Selector="Button.step">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="WrapPanel.editor > :is(Control)">
            <Setter Property="Margin" Value="0,0,16,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.number">
            <Setter Property="Width" Value="90" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Menge, dabei, gekauft, Gewicht und Preis je Stück: gleich für Waffen, Rüstungen und Gegenstände -->
        <DataTemplate x:Key="RowEditor" x:DataType="vm:EquipmentRowViewModel">
            <StackPanel Spacing="2" Margin="4,4,4,0">
                <WrapPanel Classes="editor">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Menge" VerticalAlignment="Center" />
                        <Button Classes="step" Content="−" Command="{Binding DecreaseCommand}" ToolTip.Tip="Weniger" />
                        <TextBlock Text="{Binding Quantity}" MinWidth="24" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Classes="step" Content="+" Command="{Binding IncreaseCommand}" ToolTip.Tip="Mehr" />
                    </StackPanel>
                    <CheckBox Content="dabei" IsChecked="{Binding Carried}" ToolTip.Tip="Zählt zur Traglast" />
                    <CheckBox Content="gekauft" IsChecked="{Binding Paid}" ToolTip.Tip="Der Preis geht vom Geld ab" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Stein" VerticalAlignment="Center" />
                        <TextBox Classes="number" Text="{Binding WeightInput, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="S" VerticalAlignment="Center" />
                        <TextBox Classes="number" Text="{Binding PriceInput, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding RuleValuesText}" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                           IsVisible="{Binding RuleValuesText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="8" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Classes="h1" Text="Ausrüstung" />

            <!-- Rüstung und Belastung: Ausgangswert der Rüstung und abgeleiteter Wert -->
            <Border Classes="summary">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ArmorText" Text="{Binding ArmorText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="EncumbranceText" Text="{Binding EncumbranceText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EffectsText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                               IsVisible="{Binding EffectsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding ValuesText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock x:Name="LoadText" Text="{Binding LoadText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LoadEffectText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                               IsVisible="{Binding LoadEffectText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>

            <!-- Geld: Startkapital + Einnahmen/Ausgaben − gekaufte Ausrüstung -->
            <Border Classes="summary">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Geld" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="MoneyText" Text="{Binding MoneyText}" FontWeight="SemiBold" FontSize="18"
                                   Classes.negative="{Binding MoneyNegative}" />
                    </StackPanel>
                    <TextBlock Text="{Binding MoneyDetailText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Bookings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MoneyRowViewModel">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Classes="remove" Content="✕" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="Buchung entfernen" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Classes="editor" Margin="0,4,0,0">
                        <TextBox x:Name="BookingAmount" Classes="number" Watermark="± S" Text="{Binding BookingAmount}" />
                        <TextBox Width="200" Watermark="Wofür? (Belohnung, Unterkunft …)" Text="{Binding BookingText}" />
                        <Button x:Name="BookButton" Content="Buchen" Command="{Binding BookCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock Classes="h2" Text="Waffen" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="AddWeaponButton" Content="＋ Waffe" Command="{Binding AddWeaponCommand}" />
            </Grid>
            <ItemsControl x:Name="WeaponList" ItemsSource="{Binding Weapons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WeaponRowViewModel">
                        <Border Classes="equipmentRow">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                    <CheckBox IsChecked="{Binding Wielded}" ToolTip.Tip="Geführt" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding ToggleDetailsCommand}" Background="Transparent" Padding="4"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ValuesText}" FontSize="15" />
                                            <TextBlock Text="{Binding BonusText}" FontSize="12" TextWrapping="Wrap"
                                                       IsVisible="{Binding BonusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding WeightPriceText}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="remove" Content="✕" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="Entfernen" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding IssueText}" Foreground="#C42B1C" FontSize="12" TextWrapping="Wrap" Margin="4,0"
                                           IsVisible="{Binding IssueText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowEditor}"
                                                IsVisible="{Binding ShowDetails}" />
                                <TextBlock Text="{Binding Details}" FontSize="12" TextWrapping="Wrap" Margin="4,4,4,4" Opacity="0.85"
                                           IsVisible="{Binding ShowDetails}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock Classes="h2" Text="Rüstungen" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="AddArmorButton" Content="＋ Rüstung" Command="{Binding AddArmorCommand}" />
            </Grid>
            <ItemsControl x:Name="ArmorList" ItemsSource="{Binding Armors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArmorRowViewModel">
                        <Border Classes="equipmentRow">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                    <CheckBox IsChecked="{Binding Worn}" ToolTip.Tip="Angelegt" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding ToggleDetailsCommand}" Background="Transparent" Padding="4"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding WeightPriceText}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="remove" Content="✕" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="Entfernen" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding IssueText}" Foreground="#C42B1C" FontSize="12" TextWrapping="Wrap" Margin="4,0"
                                           IsVisible="{Binding IssueText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowEditor}"
                                                IsVisible="{Binding ShowDetails}" />
                                <TextBlock Text="{Binding Details}" FontSize="12" TextWrapping="Wrap" Margin="4,4,4,4" Opacity="0.85"
                                           IsVisible="{Binding ShowDetails}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock Classes="h2" Text="Gegenstände" VerticalAlignment="Center" />
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="AddItemButton" Content="＋ Gegenstand" Command="{Binding AddItemCommand}" Margin="4,0,0,4" />
                    <Button x:Name="AddPackageButton" Content="＋ Paket" Command="{Binding AddPackageCommand}" Margin="4,0,0,4" />
                    <Button x:Name="AddCustomItemButton" Content="＋ Eigener" Command="{Binding AddCustomItemCommand}" Margin="4,0,0,4"
                            ToolTip.Tip="Eigener Gegenstand mit Name, Gewicht und Preis" />
                </WrapPanel>
            </Grid>
            <ItemsControl x:Name="ItemList" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemRowViewModel">
                        <Border Classes="equipmentRow">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <Button Command="{Binding ToggleDetailsCommand}" Background="Transparent" Padding="4"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding WeightPriceText}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="remove" Content="✕" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="Entfernen" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding IssueText}" Foreground="#C42B1C" FontSize="12" TextWrapping="Wrap" Margin="4,0"
                                           IsVisible="{Binding IssueText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,4,4,0" IsVisible="{Binding ShowDetails}">
                                    <TextBlock Text="Name" VerticalAlignment="Center" />
                                    <TextBox Width="260" Text="{Binding NameInput, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowEditor}"
                                                IsVisible="{Binding ShowDetails}" />
                                <TextBlock Text="{Binding Details}" FontSize="12" TextWrapping="Wrap" Margin="4,4,4,4" Opacity="0.85"
                                           IsVisible="{Binding ShowDetails}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
