<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">
    <StackPanel Margin="24" Spacing="8">
        <TextBlock Classes="h1" Text="{Binding Title}" />
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
</UserControl>
