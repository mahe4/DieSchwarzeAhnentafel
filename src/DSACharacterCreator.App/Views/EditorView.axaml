<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             xmlns:views="using:DSACharacterCreator.Views"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="DSACharacterCreator.Views.EditorView"
             x:DataType="vm:EditorViewModel">

    <!--
      Adaptives Layout über Breitenklassen (WidthClasses, shellCompact/shellNarrow):
        ≥ 1200 px  Kopfzeile · Navigation links · Inhalt · Übersicht rechts
        800–1199   Kopfzeile mit AP-Konto · Navigation links · Inhalt
        < 800      Kopfzeile mit AP-Konto · Inhalt · Navigation unten
    -->
    <Panel views:WidthClasses.Rules="shellCompact:..1200 shellNarrow:..800">
        <Panel.Styles>
            <!-- Standardwerte als Styles, nicht als lokale Werte: lokale Werte hätten Vorrang vor den Breitenklassen. -->
            <Style Selector="Border#NavHost">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="Width" Value="240" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
            </Style>
            <Style Selector="Border#CompactBar">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <!-- Navigation: Auswahl je Stil (Heldendokument: getönt, Nachtlager: Bernstein-Pille) -->
            <Style Selector="ListBox#Nav ListBoxItem">
                <Setter Property="Margin" Value="6,1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="CornerRadius" Value="{DynamicResource NavItemCornerRadius}" />
                <Setter Property="Foreground" Value="{DynamicResource NavForeground}" />
            </Style>
            <Style Selector="ListBox#Nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="CornerRadius" Value="{DynamicResource NavItemCornerRadius}" />
            </Style>
            <Style Selector="ListBox#Nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox#Nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox#Nav ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource NavSelectedForeground}" />
            </Style>
            <Style Selector="Grid.header Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="ListBox#Nav Path.navIcon">
                <Setter Property="Stroke" Value="{DynamicResource NavForeground}" />
            </Style>
            <Style Selector="ListBox#Nav ListBoxItem:selected Path.navIcon">
                <Setter Property="Stroke" Value="{DynamicResource NavSelectedForeground}" />
            </Style>
            <Style Selector="ListBox#Nav ListBoxItem:selected TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource NavSelectedForeground}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style Selector="Border#PickerHost, Border.dialogHost">
                <Setter Property="MaxWidth" Value="720" />
                <Setter Property="Margin" Value="24" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style Selector=".shellCompact Border#SummaryHost">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector=".shellCompact Border#CompactBar">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector=".shellNarrow Border#NavHost">
                <Setter Property="DockPanel.Dock" Value="Bottom" />
                <Setter Property="Width" Value="NaN" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>
            <Style Selector=".shellNarrow ListBox#Nav">
                <Setter Property="ItemsPanel">
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </Setter>
            </Style>
            <!-- 9 Bereiche nebeneinander, nur Symbole (Name als Tooltip und für Screenreader) -->
            <Style Selector=".shellNarrow ListBox#Nav ListBoxItem">
                <Setter Property="Margin" Value="1,6" />
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector=".shellNarrow ListBox#Nav TextBlock.long">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <!-- Handy: Seitenüberschriften etwas kleiner, damit AP und ＋ daneben passen -->
            <Style Selector=".shellNarrow TextBlock.h1">
                <Setter Property="FontSize" Value="21" />
            </Style>
            <!-- Handy: Knöpfe nur mit Symbol („＋“, „‹“), Kosten der Werte-Zeilen unter dem Namen statt rechts -->
            <Style Selector=".shellNarrow Button TextBlock.buttonLabel">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector=".shellNarrow Button.add, .shellNarrow Button#BackButton">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector=".shellNarrow Border.valueRow StackPanel.costColumn">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector=".shellNarrow Border.valueRow TextBlock.costInline">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <!-- Knöpfe mit langer und kurzer Beschriftung (Tiergefährten: „Vertrautentier“ / „Vertrauter“) -->
            <Style Selector="Button TextBlock.shortLabel">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector=".shellNarrow Button TextBlock.shortLabel">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector=".shellNarrow Button TextBlock.longLabel">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <!-- Geöffnetes Tier: Kopf über der Navigation nur in der Seitenleiste -->
            <Style Selector=".shellNarrow Border#CompanionCrumb">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector=".shellNarrow Border#PickerHost, .shellNarrow Border.dialogHost">
                <Setter Property="MaxWidth" Value="100000" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </Panel.Styles>

        <Panel>
        <DockPanel>
            <!-- Kopfzeile in beiden Stilen dunkel: Inhalt im dunklen Stil, Hintergrund aus dem gewählten Stil -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackground}">
                <ThemeVariantScope RequestedThemeVariant="Dark"
                                   TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                <Grid Classes="header" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="8,6">
                    <Button x:Name="BackButton" Command="{Binding BackCommand}"
                            Background="Transparent" VerticalAlignment="Center"
                            ToolTip.Tip="Zurück zur Heldenübersicht" >
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="‹" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Classes="buttonLabel" VerticalAlignment="Center" Text="Helden" />
                        </StackPanel>
                    </Button>
                    <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Name des Helden"
                             VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Stretch" MinWidth="0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Content="↶" Command="{Binding UndoCommand}" Background="Transparent"
                                FontSize="18" Padding="8,2" ToolTip.Tip="Rückgängig" />
                        <Button x:Name="RedoButton" Content="↷" Command="{Binding RedoCommand}" Background="Transparent"
                                FontSize="18" Padding="8,2" ToolTip.Tip="Wiederholen" />
                    </StackPanel>
                    <Border x:Name="CompactBar" Grid.Column="3" VerticalAlignment="Center" Padding="8,0">
                        <TextBlock Text="{Binding HeaderApText}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                </ThemeVariantScope>
            </Border>

            <Border x:Name="NavHost"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DockPanel>
                <!-- Geöffnetes Tier: zurück zur Liste, Name und Art (die Tabs des Tiers ersetzen die Navigation) -->
                <!-- Sichtbarkeit am Handy über den Stil (.shellNarrow), die Bindung deshalb am inneren Element -->
                <Border x:Name="CompanionCrumb" DockPanel.Dock="Top">
                <Border Padding="16,10,12,8"
                        IsVisible="{Binding ActiveCompanion, Converter={x:Static ObjectConverters.IsNotNull}}"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Spacing="2">
                        <Button x:Name="CompanionBackButton" Command="{Binding ActiveCompanion.CloseCommand}" Background="Transparent"
                                Padding="0" Foreground="{DynamicResource HeadingAccent}">
                            <TextBlock Text="‹ Tiergefährten" FontSize="13" />
                        </Button>
                        <WrapPanel ItemSpacing="6">
                            <TextBlock Text="{Binding ActiveCompanion.Title}" FontSize="17" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource HeadingFont}" TextWrapping="Wrap" />
                            <Border Classes="badge familiar" IsVisible="{Binding ActiveCompanion.IsFamiliar}">
                                <TextBlock Text="✦ Vertrauter" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding ActiveCompanion.State.Animal.Name}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </Border>
                <ListBox x:Name="Nav"
                         ItemsSource="{Binding NavSections}"
                         SelectedItem="{Binding NavSelectedSection}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SectionViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10" ToolTip.Tip="{Binding Title}"
                                        AutomationProperties.Name="{Binding Title}">
                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Classes="navIcon" Data="{Binding Icon, Converter={x:Static views:GeometryConverter.Instance}}" StrokeThickness="1.8"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Classes="long" Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="SummaryHost" DockPanel.Dock="Right" Width="300"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1,0,0,0">
                <ContentControl Content="{Binding CurrentSummary}" />
            </Border>

            <!-- Alle bereits geöffneten Seiten bleiben erhalten, nur die gewählte ist sichtbar (schneller Wechsel). -->
            <Panel>
            <ItemsControl x:Name="CompanionPages" ItemsSource="{Binding ActiveCompanion.Sections}"
                          IsVisible="{Binding ActiveCompanion, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Panel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SectionViewModel">
                        <ContentControl Content="{Binding LoadedPage}" IsVisible="{Binding IsSelected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="Pages" ItemsSource="{Binding Sections}"
                          IsVisible="{Binding ActiveCompanion, Converter={x:Static ObjectConverters.IsNull}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Panel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SectionViewModel">
                        <ContentControl Content="{Binding LoadedPage}" IsVisible="{Binding IsSelected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Panel>
        </DockPanel>

        <!-- Rückfrage -->
        <Border x:Name="ConfirmationOverlay" IsVisible="{Binding Confirmation, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#80000000" ZIndex="2">
            <Border MaxWidth="440" Margin="16" Padding="20" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel Spacing="16">
                    <TextBlock Classes="h2" Text="{Binding Confirmation.Title}" />
                    <TextBlock Text="{Binding Confirmation.Message}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Abbrechen" Command="{Binding Confirmation.CancelCommand}" Padding="16,8" />
                        <Button x:Name="ConfirmButton" Content="{Binding Confirmation.ConfirmText}"
                                Command="{Binding Confirmation.ConfirmCommand}" Padding="16,8"
                                Classes="danger" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Auswahlliste (Kultur, Profession) -->
        <Border x:Name="PickerOverlay" IsVisible="{Binding Picker, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#80000000">
            <Border x:Name="PickerHost" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <views:PickerView DataContext="{Binding Picker}" />
            </Border>
        </Border>

        <!-- Quellenauswahl des Helden -->
        <Border x:Name="SourcesOverlay" IsVisible="{Binding Sources, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#80000000">
            <Border Classes="dialogHost" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <views:SourcesView DataContext="{Binding Sources}" />
            </Border>
        </Border>
        </Panel>
    </Panel>
</UserControl>
