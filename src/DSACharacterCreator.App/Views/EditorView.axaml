<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             xmlns:views="using:DSACharacterCreator.Views"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="DSACharacterCreator.Views.EditorView"
             x:DataType="vm:EditorViewModel">

    <!--
      Adaptives Layout über Container Queries:
        ≥ 1200 px  Kopfzeile · Navigation links · Inhalt · Übersicht rechts
        800–1199   Kopfzeile mit AP-Konto · Navigation links · Inhalt
        < 800      Kopfzeile mit AP-Konto · Inhalt · Navigation unten
    -->
    <Panel Container.Name="Shell" Container.Sizing="Width">
        <Panel.Styles>
            <!-- Standardwerte als Styles, nicht als lokale Werte: lokale Werte hätten Vorrang vor den Container Queries. -->
            <Style Selector="Border#NavHost">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="Width" Value="240" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
            </Style>
            <Style Selector="Border#CompactBar">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="ListBox#Nav TextBlock.short">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="Border#PickerHost, Border.dialogHost">
                <Setter Property="MaxWidth" Value="720" />
                <Setter Property="Margin" Value="24" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <ContainerQuery Name="Shell" Query="max-width:1199">
                <Style Selector="Border#SummaryHost">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="Border#CompactBar">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </ContainerQuery>
            <ContainerQuery Name="Shell" Query="max-width:799">
                <Style Selector="Border#NavHost">
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                </Style>
                <Style Selector="ListBox#Nav">
                    <Setter Property="ItemsPanel">
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </Setter>
                </Style>
                <!-- 9 Bereiche nebeneinander: knapper Innenabstand, damit „Talente“ auch bei 360 px passt. -->
                <Style Selector="ListBox#Nav ListBoxItem">
                    <Setter Property="Padding" Value="0,12" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="ListBox#Nav TextBlock.long">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="ListBox#Nav TextBlock.short">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="Border#PickerHost, Border.dialogHost">
                    <Setter Property="MaxWidth" Value="100000" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                </Style>
            </ContainerQuery>
        </Panel.Styles>

        <Panel>
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="8,6"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Button x:Name="BackButton" Command="{Binding BackCommand}" Content="‹ Helden"
                            Background="Transparent" VerticalAlignment="Center"
                            ToolTip.Tip="Zurück zur Heldenübersicht" />
                    <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Name des Helden"
                             VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Stretch" MinWidth="0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Content="↶" Command="{Binding UndoCommand}" Background="Transparent"
                                FontSize="18" Padding="8,2" ToolTip.Tip="Rückgängig" />
                        <Button x:Name="RedoButton" Content="↷" Command="{Binding RedoCommand}" Background="Transparent"
                                FontSize="18" Padding="8,2" ToolTip.Tip="Wiederholen" />
                    </StackPanel>
                    <Border x:Name="CompactBar" Grid.Column="3" VerticalAlignment="Center" Padding="8,0">
                        <TextBlock Text="{Binding Summary.ApText}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="NavHost"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <ListBox x:Name="Nav"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SectionViewModel">
                            <Panel>
                                <TextBlock Classes="long" Text="{Binding Title}" />
                                <TextBlock Classes="short" Text="{Binding ShortTitle}"
                                           FontSize="11" HorizontalAlignment="Center" />
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="SummaryHost" DockPanel.Dock="Right" Width="300"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1,0,0,0">
                <views:SummaryView DataContext="{Binding Summary}" />
            </Border>

            <!-- Alle bereits geöffneten Seiten bleiben erhalten, nur die gewählte ist sichtbar (schneller Wechsel). -->
            <ItemsControl x:Name="Pages" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Panel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SectionViewModel">
                        <ContentControl Content="{Binding LoadedPage}" IsVisible="{Binding IsSelected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Rückfrage -->
        <Border x:Name="ConfirmationOverlay" IsVisible="{Binding Confirmation, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#80000000" ZIndex="2">
            <Border MaxWidth="440" Margin="16" Padding="20" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel Spacing="16">
                    <TextBlock Classes="h2" Text="{Binding Confirmation.Title}" />
                    <TextBlock Text="{Binding Confirmation.Message}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Abbrechen" Command="{Binding Confirmation.CancelCommand}" Padding="16,8" />
                        <Button x:Name="ConfirmButton" Content="{Binding Confirmation.ConfirmText}"
                                Command="{Binding Confirmation.ConfirmCommand}" Padding="16,8"
                                Background="#C42B1C" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Auswahlliste (Kultur, Profession) -->
        <Border x:Name="PickerOverlay" IsVisible="{Binding Picker, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#80000000">
            <Border x:Name="PickerHost" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <views:PickerView DataContext="{Binding Picker}" />
            </Border>
        </Border>

        <!-- Quellenauswahl des Helden -->
        <Border x:Name="SourcesOverlay" IsVisible="{Binding Sources, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#80000000">
            <Border Classes="dialogHost" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <views:SourcesView DataContext="{Binding Sources}" />
            </Border>
        </Border>
        </Panel>
    </Panel>
</UserControl>
