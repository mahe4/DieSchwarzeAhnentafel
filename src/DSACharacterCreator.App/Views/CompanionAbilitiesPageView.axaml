<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.CompanionAbilitiesPageView"
             x:DataType="vm:CompanionAbilitiesPageViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="8" MaxWidth="820" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="h1" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="pageAp" Text="{Binding PageApText}" ToolTip.Tip="In diesem Bereich ausgegebene AP des Tiers" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding Hint}" />
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CompanionAbilityGroupViewModel">
                        <StackPanel Spacing="4" Margin="0,12,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="h2" Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="add" Content="{Binding AddLabel}" Command="{Binding AddCommand}"
                                        ToolTip.Tip="{Binding AddLabel, StringFormat='{}{0} hinzufügen'}" />
                            </Grid>
                            <TextBlock Classes="hint" Text="keine" IsVisible="{Binding IsEmpty}" Margin="4,0" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CompanionAbilityRowViewModel">
                                        <Border Classes="traitRow">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                    <Button Classes="rowTitle" Command="{Binding ToggleDetailsCommand}" IsEnabled="{Binding HasDetails}"
                                                            Background="Transparent" Padding="4"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="⚠" Foreground="{DynamicResource WarningBrush}"
                                                                           IsVisible="{Binding IssueText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ApText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                                                            Classes="step" ToolTip.Tip="Entfernen" />
                                                </Grid>
                                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                                          IsVisible="{Binding HasOptions}" MinWidth="240" Margin="4,0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ChoiceOption">
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Text="{Binding ManualApText, UpdateSourceTrigger=LostFocus}" Width="160" Margin="4,0"
                                                         HorizontalAlignment="Left" PlaceholderText="AP-Wert eintragen"
                                                         IsVisible="{Binding IsManualCost}" />
                                                <TextBlock Text="{Binding IssueText}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                                           TextWrapping="Wrap" Margin="4,0"
                                                           IsVisible="{Binding IssueText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Text="{Binding Details}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Margin="4,0,4,4"
                                                           IsVisible="{Binding ShowDetails}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
