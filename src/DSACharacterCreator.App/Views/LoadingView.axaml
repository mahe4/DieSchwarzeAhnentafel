<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.LoadingView"
             x:DataType="vm:LoadingViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24">
        <ProgressBar IsIndeterminate="True" Width="200" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNull}}" />
        <TextBlock Text="Regeldaten werden geladen …" HorizontalAlignment="Center"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNull}}" />
        <TextBlock Text="{Binding Error}" Foreground="#C42B1C" TextWrapping="Wrap" MaxWidth="400" />
    </StackPanel>
</UserControl>
