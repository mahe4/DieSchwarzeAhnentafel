<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DSACharacterCreator.Views"
             xmlns:vm="using:DSACharacterCreator.ViewModels"
             x:Class="DSACharacterCreator.Views.CompanionResultPageView"
             x:DataType="vm:CompanionResultPageViewModel">
    <!-- Ergebnis wie ein Tierkasten: Kästen, ab 700 px zweispaltig. -->
    <Panel views:WidthClasses.Rules="resultWide:700..">
        <Panel.Styles>
            <!-- Schmal: Spalten untereinander; breit: nebeneinander -->
            <Style Selector="StackPanel.leftColumn">
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
            <Style Selector="StackPanel.rightColumn">
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Margin" Value="0,12,0,0" />
            </Style>
            <Style Selector=".resultWide StackPanel.leftColumn">
                <Setter Property="Grid.ColumnSpan" Value="1" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
            <Style Selector=".resultWide StackPanel.rightColumn">
                <Setter Property="Grid.ColumnSpan" Value="1" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
            <Style Selector="UniformGrid#AttributeGrid">
                <Setter Property="Columns" Value="4" />
            </Style>
            <Style Selector=".resultWide UniformGrid#AttributeGrid">
                <Setter Property="Columns" Value="8" />
            </Style>
        </Panel.Styles>
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="12" MaxWidth="960" HorizontalAlignment="Stretch">
                <TextBlock Classes="h1" Text="{Binding Owner.Title}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Owner.Subtitle}" Opacity="0.7" TextWrapping="Wrap" Margin="0,-8,0,0" />
                <TextBlock Classes="hint" IsVisible="{Binding !HasAnimal}" Text="Noch keine Tierart gewählt (Tab Grundlagen)." />

                <Border Classes="box">
                    <StackPanel>
                        <TextBlock Classes="boxTitle" Text="Eigenschaften" />
                        <ItemsControl ItemsSource="{Binding Attributes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid x:Name="AttributeGrid" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LabeledValue">
                                    <StackPanel Margin="2,4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <TextBlock Text="{Binding Value}" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="hint" Text="{Binding AttributeNote}" IsVisible="{Binding AttributeNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- Zwei Spalten (breit) bzw. untereinander; jede Spalte so hoch wie ihr Inhalt -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <StackPanel Classes="leftColumn" Spacing="12">
                        <Border Classes="box">
                            <StackPanel>
                                <TextBlock Classes="boxTitle" Text="Basiswerte" />
                                <ItemsControl ItemsSource="{Binding BaseValues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LabeledValue">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextAlignment="Right"
                                                           TextWrapping="Wrap" MaxWidth="200" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="box">
                            <StackPanel>
                                <TextBlock Classes="boxTitle" Text="Talente" />
                                <TextBlock Text="{Binding SkillsText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Classes="box">
                            <StackPanel>
                                <TextBlock Classes="boxTitle" Text="Vor- und Nachteile" />
                                <TextBlock Text="{Binding TraitsText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Classes="rightColumn" Spacing="12">
                        <Border Classes="box">
                            <StackPanel>
                                <TextBlock Classes="boxTitle" Text="Angriffe" />
                                <Grid ColumnDefinitions="*,48,80,64" Opacity="0.65">
                                    <TextBlock Text="Angriff" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="AT" FontSize="12" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="TP" FontSize="12" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="RW" FontSize="12" TextAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Attacks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AttackLine">
                                            <Grid ColumnDefinitions="*,48,80,64" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Attack}" FontWeight="SemiBold" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Damage}" TextAlignment="Right" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="{Binding Reach}" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="hint" Text="{Binding ActionsText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Classes="box">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="boxTitle" Text="{Binding TricksTitle}" />
                                <TextBlock Text="{Binding TricksText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TrainingText}" TextWrapping="Wrap" FontSize="13" Opacity="0.85" />
                            </StackPanel>
                        </Border>
                        <Border Classes="box">
                            <StackPanel>
                                <TextBlock Classes="boxTitle" Text="Sonderfertigkeiten" />
                                <TextBlock Text="{Binding SpecialAbilitiesText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Classes="box" IsVisible="{Binding SpecialRulesText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel>
                        <TextBlock Classes="boxTitle" Text="Sonderregeln" />
                        <TextBlock Text="{Binding SpecialRulesText}" TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                </Border>
                <Border Classes="box" IsVisible="{Binding PersonalText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel>
                        <TextBlock Classes="boxTitle" Text="Aussehen &amp; Notizen" />
                        <TextBlock Text="{Binding PersonalText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
