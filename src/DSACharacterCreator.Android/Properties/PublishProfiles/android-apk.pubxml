<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- APK zum direkten Installieren auf dem Handy (ohne App-Store). Signiert mit dem Debug-Schlüssel dieses Rechners,
       lässt sich also über aus der IDE installierte Versionen installieren; für einen Store braucht es einen eigenen
       Keystore.
       dotnet publish src/DSACharacterCreator.Android -p:PublishProfile=android-apk -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- nur aktuelle Handys: ohne den x86_64-Code für Emulatoren, etwa halb so großes APK -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <PublishDir>bin\publish\android\</PublishDir>
    <!-- Eine von außen gesetzte Konfiguration (IDE, dotnet publish -c Debug) geht vor. Ein Debug-Build ließe die
         Assemblies wegen Fast Deployment aus dem APK weg, die installierte App würde sofort beendet (siehe CLAUDE.md). -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <Target Name="WarnAboutDebugApk" BeforeTargets="Build" Condition="'$(Configuration)' != 'Release'">
    <Warning Text="Das APK wird in der Konfiguration '$(Configuration)' gebaut: Es läuft, ist aber langsamer und größer. Für die Weitergabe mit der Konfiguration Release veröffentlichen." />
  </Target>
</Project>
